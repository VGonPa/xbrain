#!/usr/bin/env python3
"""XBrain transcriber wrapper for faster-whisper.

XBrain invokes `<command> [--model M] --output-format json --output-dir <DIR>
<media>`. This wrapper adapts that contract to `faster_whisper.WhisperModel`,
writing one JSON file with:

    {"text": "...", "language": "en", "segments": [...], "has_speech": true}

No media bytes are written outside XBrain's temporary digest directory. By
default the wrapper extracts a mono 16k WAV into the same temp output directory
and transcribes that smaller audio file, reducing CPU/decoder work for long
videos. Model files are cached by faster-whisper/Hugging Face; set
`XBRAIN_WHISPER_CACHE` to control that location on a VPS. On CPU,
`XBRAIN_WHISPER_BEAM_SIZE=1` is the default speed/quality trade-off for long
videos; raise it to 3 or 5 when accuracy matters more than runtime.
Set `XBRAIN_WHISPER_DELETE_SOURCE_AFTER_AUDIO=1` only when the input media is an
ephemeral XBrain temp file; then the MP4 is removed immediately after WAV
extraction to reduce temporary disk pressure during long ASR runs.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any


def _confirmed_no_audio(media: Path) -> bool:
    ffprobe = shutil.which("ffprobe")
    if not ffprobe:
        return False
    probe = subprocess.run(
        [
            ffprobe,
            "-v",
            "error",
            "-select_streams",
            "a",
            "-show_entries",
            "stream=codec_type",
            "-of",
            "csv=p=0",
            str(media),
        ],
        capture_output=True,
        text=True,
    )
    return probe.returncode == 0 and "audio" not in probe.stdout


def _write_json(output_dir: Path, media: Path, payload: dict[str, Any]) -> None:
    output_dir.mkdir(parents=True, exist_ok=True)
    (output_dir / f"{media.stem}.json").write_text(
        json.dumps(payload, ensure_ascii=False),
        encoding="utf-8",
    )


def _audio_only_enabled() -> bool:
    return _bool_env("XBRAIN_WHISPER_AUDIO_ONLY", True)


def _delete_source_after_audio_enabled() -> bool:
    return _bool_env("XBRAIN_WHISPER_DELETE_SOURCE_AFTER_AUDIO", False)


def _audio_input(media: Path, output_dir: Path) -> Path:
    if not _audio_only_enabled():
        return media
    ffmpeg = shutil.which("ffmpeg")
    if not ffmpeg:
        return media
    output_dir.mkdir(parents=True, exist_ok=True)
    audio = output_dir / f"{media.stem}.wav"
    completed = subprocess.run(
        [
            ffmpeg,
            "-hide_banner",
            "-loglevel",
            "error",
            "-y",
            "-i",
            str(media),
            "-vn",
            "-ac",
            "1",
            "-ar",
            "16000",
            "-f",
            "wav",
            str(audio),
        ],
        capture_output=True,
        text=True,
    )
    if completed.returncode != 0:
        raise RuntimeError(completed.stderr.strip() or "ffmpeg audio extraction failed")
    if not audio.exists() or audio.stat().st_size <= 44:
        raise RuntimeError("ffmpeg produced no usable audio")
    if _delete_source_after_audio_enabled():
        media.unlink(missing_ok=True)
    return audio


def _parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Transcribe media for XBrain using faster-whisper")
    parser.add_argument("media", type=Path)
    parser.add_argument("--model", default=os.environ.get("XBRAIN_WHISPER_MODEL", "base"))
    parser.add_argument("--output-format", choices=["json"], default="json")
    parser.add_argument("--output-dir", type=Path, required=True)
    parser.add_argument("--language", default=os.environ.get("XBRAIN_WHISPER_LANGUAGE") or None)
    return parser.parse_args(argv)


def _bool_env(name: str, default: bool) -> bool:
    value = os.environ.get(name)
    if value is None:
        return default
    return value.strip().lower() not in {"0", "false", "no", "off"}


def _int_env(name: str, default: int) -> int:
    value = os.environ.get(name)
    if value is None:
        return default
    try:
        return int(value)
    except ValueError:
        return default


def main(argv: list[str] | None = None) -> int:
    args = _parse_args(argv or sys.argv[1:])
    media = args.media
    if _confirmed_no_audio(media):
        _write_json(
            args.output_dir,
            media,
            {"text": "", "language": args.language, "segments": [], "has_speech": False},
        )
        return 0

    try:
        from faster_whisper import WhisperModel
    except ImportError as exc:
        print(f"xbrain-transcribe-faster-whisper: faster-whisper not installed: {exc}", file=sys.stderr)
        return 127

    device = os.environ.get("XBRAIN_WHISPER_DEVICE", "cpu")
    compute_type = os.environ.get("XBRAIN_WHISPER_COMPUTE_TYPE", "int8")
    cpu_threads = _int_env("XBRAIN_WHISPER_CPU_THREADS", max(1, os.cpu_count() or 1))
    download_root = os.environ.get("XBRAIN_WHISPER_CACHE") or None
    vad_filter = _bool_env("XBRAIN_WHISPER_VAD", True)
    beam_size = _int_env("XBRAIN_WHISPER_BEAM_SIZE", 1)

    try:
        model = WhisperModel(
            args.model,
            device=device,
            compute_type=compute_type,
            cpu_threads=cpu_threads,
            download_root=download_root,
        )
        source = _audio_input(media, args.output_dir)
        segments_iter, info = model.transcribe(
            str(source),
            language=args.language,
            vad_filter=vad_filter,
            beam_size=beam_size,
        )
        segments = [
            {
                "start": float(segment.start),
                "end": float(segment.end),
                "text": segment.text.strip(),
            }
            for segment in segments_iter
            if segment.text.strip()
        ]
    except Exception as exc:
        print(f"xbrain-transcribe-faster-whisper: transcription failed: {exc}", file=sys.stderr)
        return 1

    text = " ".join(segment["text"] for segment in segments).strip()
    _write_json(
        args.output_dir,
        media,
        {
            "text": text,
            "language": getattr(info, "language", None) or args.language,
            "segments": segments,
            "has_speech": bool(text),
        },
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
