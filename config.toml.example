[paths]
# Absolute path to your Obsidian vault root.
vault = "/absolute/path/to/your/obsidian/vault"
# Output folder for generated markdown, relative to the vault root.
output_subdir = "learnings/x-knowledge"
# Data directory for the JSON store, relative to the repo root.
data_dir = "data"

[drive]
# Google Drive is opt-in. When enabled, XBrain uses a local cache and syncs it
# with the selected Drive folder before/after write commands. When disabled,
# all library files stay local using [paths].
enabled = false
# Set with `xbrain drive select-root <folder-id>` or paste it here.
# root_folder_id = ""
# Local working cache used only when enabled=true.
cache_dir = ".xbrain-cache/google-drive"
# OAuth desktop-client JSON downloaded from Google Cloud Console.
credentials_path = "auth/google_drive_credentials.json"
# User token created by `xbrain drive login`; keep it local and gitignored.
token_path = "auth/google_drive_token.json"

[email]
# Optional notification after bookmark updates. It only sends when both
# [drive].enabled=true and [email].enabled=true.
enabled = false
recipient = "you@example.com"
# Sender may also be set with XBRAIN_EMAIL_FROM. Keep SMTP secrets in .env/env.
sender = ""
smtp_host = ""
smtp_port = 587
smtp_starttls = true
smtp_ssl = false

[snapshots]
# Keep this many newest automatic snapshots. Manual snapshots are never removed
# by the automatic policy. Set to 0 to disable automatic pruning.
auto_prune_keep_last = 25

[x]
# Your X handle, without the @.
handle = "your_handle"

[llm]
# Text LLM provider for the "api" executor:
#   "nanogpt"   - calls NanoGPT's OpenAI-compatible chat completions API [default]
#   "anthropic" - Anthropic provider for all API-backed LLM calls (needs ANTHROPIC_API_KEY)
provider = "nanogpt"
# NanoGPT-only API base URL; ignored when provider = "anthropic".
base_url = "https://nano-gpt.com/api/v1"
# API LLM model used by text stages: enrich, vocab and topics.
model = "zai-org/glm-5.2"
# Separate API LLM model for image/vision tasks (`describe`).
# With NanoGPT, default is xiaomi/mimo-v2.5 because text-only models may not process images.
vision_model = "xiaomi/mimo-v2.5"

[enrich]
# Executor that produces the LLM judgment:
#   "claude-code" - exports a worksheet a Claude Code session fills (no API cost) [default]
#   "api"         - calls [llm].provider (NanoGPT by default, needs NANOGPT_API_KEY)
#   "manual"      - exports a worksheet to fill by hand
executor = "claude-code"

[vocab]
# Number of topics the `vocab` stage induces from the corpus.
target_count = 30

[topics]
# Re-synthesize a topic's overview when it has grown by this many posts since
# the last synthesis. `xbrain topics --resynth` re-synthesizes every stale one.
resynth_threshold = 25

[output]
# Output language for LLM-generated summaries/overviews AND the wiki's
# section headers (Topics:, Content:, Summary, ...). Supported values:
#   "English" - default
#   "Spanish"
language = "English"
# How the in-body `**Topics:**` line is rendered on each item note.
# Frontmatter `tags:` are unaffected by this setting. Supported values:
#   "wikilink" - **Topics:** [[ai-coding]] · [[software-engineering]]  (default)
#   "hashtag"  - **Topics:** #ai-coding #software-engineering
topic_style = "wikilink"

[describe]
# Description-version tag persisted on every described image. Bumping
# this value invalidates existing descriptions: the next `xbrain
# describe` run re-describes stale entries automatically. Use it when
# you change the describe-image rubric or expectations.
version = "v1"

[transcribe]
# Optional ASR fallback for `xbrain digest-video` when X does not expose captions.
# XBrain may stream the MP4 into a private temporary directory, run this
# external command, store only the transcript text, and delete the temporary
# media bytes. It never stores MP4/audio/frames in data/ or the vault.
command = "parakeet-mlx"
# model = "parakeet-tdt-0.6b-v2"
#
# Linux/VPS CPU example after installing faster-whisper in /opt/xbrain-asr.
# The wrapper streams the MP4 into XBrain's temp dir, extracts mono 16k audio
# there, transcribes that smaller WAV, and deletes every temporary media file.
# `XBRAIN_WHISPER_BEAM_SIZE=1` is the recommended VPS default for long videos;
# raise it to 3/5 if you prefer accuracy over runtime.
# command = "env XBRAIN_WHISPER_CACHE=/opt/xbrain-asr/models XBRAIN_WHISPER_CPU_THREADS=6 XBRAIN_WHISPER_BEAM_SIZE=1 XBRAIN_WHISPER_DELETE_SOURCE_AFTER_AUDIO=1 /opt/xbrain-asr/bin/python /absolute/path/to/xbrain/scripts/xbrain-transcribe-faster-whisper"
# model = "small"
# timeout_seconds = 7200

# Video policy:
# `xbrain digest-video` never stores MP4, audio or frames. It uses caption/text
# tracks captured from X when available; otherwise it may use the temporary ASR
# fallback above. The raw transcript is a reference artifact; only the executive
# summary flows through enrich/topics/dashboard/Ask.
