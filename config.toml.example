[paths]
# Absolute path to your Obsidian vault root.
vault = "/absolute/path/to/your/obsidian/vault"
# Output folder for generated markdown, relative to the vault root.
output_subdir = "learnings/x-knowledge"
# Data directory for the JSON store, relative to the repo root.
data_dir = "data"

[x]
# Your X handle, without the @.
handle = "your_handle"

[enrich]
# Executor that produces the LLM judgment:
#   "claude-code" - exports a worksheet a Claude Code session fills (no API cost) [default]
#   "api"         - calls the Anthropic API (needs ANTHROPIC_API_KEY, pay-per-token)
#   "manual"      - exports a worksheet to fill by hand
# Also read by `xbrain video-digest` and `xbrain verify` — they have no config
# section of their own. Those two run only the worksheet tracks
# ("claude-code" / "manual"), never "api".
executor = "claude-code"
# Model used by the "api" executor. A cheap model for volume; a stronger one for quality.
model = "claude-haiku-4-5-20251001"

[vocab]
# Number of topics the `vocab` stage induces from the corpus.
target_count = 30

[topics]
# Re-synthesize a topic's overview when it has grown by this many posts since
# the last synthesis. `xbrain topics --resynth` re-synthesizes every stale one.
resynth_threshold = 25

[output]
# Output language for LLM-generated summaries/overviews AND the wiki's
# section headers (Topics:, Content:, Summary, ...). Supported values:
#   "English" - default
#   "Spanish"
language = "English"
# How the in-body `**Topics:**` line is rendered on each item note.
# Frontmatter `tags:` are unaffected by this setting. Supported values:
#   "wikilink" - **Topics:** [[ai-coding]] · [[software-engineering]]  (default)
#   "hashtag"  - **Topics:** #ai-coding #software-engineering
topic_style = "wikilink"

[describe]
# Vision model used by `xbrain describe`. Sonnet 4.6 is the default —
# the quality / cost sweet spot (~$3-5 for a 2k-image corpus). Override
# per run with `--model` while iterating; the CLI flag wins.
model = "claude-sonnet-4-6"
# Description-version tag persisted on every described photo. Bumping
# this value invalidates existing descriptions: the next `xbrain
# describe` run re-describes stale entries automatically. Use it when
# you change the describe-image rubric or expectations.
version = "v1"

[transcribe]
# External transcriber that `xbrain digest-video` shells out to. The heavy ASR
# (Parakeet TDT 0.6b via `parakeet-mlx` on Apple Silicon; `whisper` /
# `faster-whisper` is the portable fallback) lives OUTSIDE xbrain core — the CLI
# carries no MLX/CoreML dependency and only invokes this command as a subprocess.
# May be a multi-token wrapper (split with shlex, run without a shell). xbrain
# invokes:  <command> [--model M] --output-format json --output-dir <TMPDIR> <mediapath>
# and reads the JSON transcript from the FILE parakeet-mlx writes at
# <TMPDIR>/<stem>.json ({"text", "language", "segments":[{start,end,text}]}).
# Note: --language is NOT passed (parakeet auto-detects and rejects it). A wrapper
# that emits JSON on stdout instead of a file is also supported.
#
# The bundled `scripts/xbrain-transcribe` wraps parakeet-mlx so videos with NO
# audio track (silent clips, GIFs) attach as has_speech=false instead of failing
# (parakeet writes no file for them). Point at the wrapper, or straight at
# `parakeet-mlx` if you don't need silent-video handling.
#
# ON A MULTILINGUAL CORPUS, USE `scripts/xbrain-transcribe-auto` INSTEAD.
# parakeet-mlx is English-only and does not fail on other languages — it
# FABRICATES fluent English from Spanish audio, which is the worst failure mode
# available: a confident transcript nobody can tell is invented, feeding the
# digest and every downstream summary. The router detects the language on the
# first 30s and dispatches: English → parakeet (fast), anything else or any
# uncertainty → whisper. It prefers `xbrain-transcribe-mlx` (mlx-whisper on the
# Apple GPU, ~25x faster than CPU whisper on the same clip and byte-identical
# output) and falls back to `xbrain-transcribe-whisper` (brew whisper, CPU,
# portable). Tuning knobs (all optional env vars): XBRAIN_ASR_DETECT_MODEL
# (default `base`), XBRAIN_ASR_DETECT_SECONDS (30), XBRAIN_ASR_FORCE to pin one
# backend, and XBRAIN_TRANSCRIBE_{PARAKEET,MLX,WHISPER} to override each binary.
command = "parakeet-mlx"
# command = "/absolute/path/to/scripts/xbrain-transcribe"
# command = "/absolute/path/to/scripts/xbrain-transcribe-auto"   # multilingual
# Optional model id passed through to the transcriber. Omit for the tool default.
# model = "parakeet-tdt-0.6b-v2"

[vision]
# External vision model that `xbrain digest-video --frames` shells out to (#44
# PR4) to describe key-frame slides. Like the transcriber, the heavy vision lives
# OUTSIDE xbrain core — the CLI carries no vision/ML dependency and only invokes
# this command as a subprocess. There is NO bundled default: leave it unset and
# `--frames` errors clearly until you configure a local VLM. xbrain invokes:
#   <command> [--model M] <image-path>
# and reads the frame's text description from stdout. May be a multi-token wrapper
# (split with shlex, run without a shell). `--frames` is fully opt-in: a normal
# `digest-video` run never touches ffmpeg or this command.
#
# xbrain also sets XBRAIN_VISION_PROMPT in the command's environment, carrying the
# frame-caption rubric (transcribe on-screen text verbatim, never translated). The
# argv is unchanged, so a command that ignores the variable still works — it just
# gets no caption discipline, and its captions will not ground what the digest
# says about the screen. A custom command SHOULD read it and use it as the prompt.
#
# The bundled `scripts/xbrain-vision` wrapper is a MULTI-BACKEND SELECTOR: the
# `--model` name routes to a local mlx-vlm model OR a cloud Claude model, so one
# command serves both. Pick per run with `digest-video --vision-model NAME`, or
# set the default here:
#   local (Apple Silicon, free/offline): qwen-3b | qwen-7b | qwen-32b | <hf/repo>
#   cloud (needs ANTHROPIC_API_KEY):      opus | sonnet | haiku | claude-<id>
# command = "/absolute/path/to/scripts/xbrain-vision"
# model = "qwen-3b"                       # omit → the wrapper's default (qwen-3b)

[frames]
# `digest-video --frames` key-frame extraction. Pipeline: ffmpeg (scene-change +
# interval) → dedupe (perceptual hash drops near-identical held slides) → cap.
# dedupe is the real reducer, so the budget covers DISTINCT slides; max_frames is
# a safety ceiling for a pathological continuous-motion clip. A SILENT non-slide
# video is described as footage (its frames are its only content) under its own,
# smaller cap; a talking-head WITH speech is skipped (the transcript carries it).
# max_frames       = 60      # safety ceiling AFTER dedup
# footage_max_frames = 6       # cap for SILENT non-slide videos (screen recordings, GIFs, robots)
# scene_threshold  = 0.4     # ffmpeg scene-change sensitivity (higher = fewer cuts)
# interval_seconds = 15      # also keep a frame every N s (covers static tails)
# dedupe           = true    # perceptual-hash near-duplicate removal
# dedupe_distance  = 6        # max dHash Hamming distance to call two frames "same" (0-64)

[index]
# The persisted knowledge index (`xbrain index build|update|status`, `xbrain search`,
# `xbrain get`). Everything has a default: the whole section is optional and rarely
# touched.
#
# `data/index/` is DERIVED and rebuildable — never versioned, and deleting it costs
# only an `xbrain index build`. `xbrain get` does not even read it: it serves evidence
# from the live store, so it keeps working with the index deleted.
#
# dir = "index"
#   Subdirectory under `data/` holding the SQLite base and its manifest. It has to
#   stay INSIDE `data/`: a path that resolves outside it (a `..`, an absolute path or
#   a symlink) is refused when the config loads, because `index build --force` deletes
#   and recreates whatever it finds there.
#
# max_matches_per_item = 3
#   How many fragments of one item `search` may cite (spec §5.4). This is what keeps a
#   long transcript from filling the top ten with ten adjacent windows of itself.
#
# get_char_budget = 40000
#   Character ceiling per `xbrain get` response. Above it the response is truncated
#   DECLARING SO and returns a cursor to continue — never silently. ~40k is a long
#   article with its metadata: the common case does not paginate.
#
# graph_min_shared_items = 5
# graph_min_weight = 0.05
# graph_max_neighbors_per_node = 10
#   The co-occurrence graph `index build` writes beside the lexical planes. Two topics
#   get a CO_OCCURS_WITH edge when at least `graph_min_shared_items` items carry both
#   AND their Jaccard (shared items / union of their items) reaches `graph_min_weight`;
#   each topic then keeps only its `graph_max_neighbors_per_node` strongest edges. An
#   edge means "assigned together to these items of xbrain", never "related in the
#   world". The two thresholds are MEASURED (docs/graph-threshold-sweep.md): no
#   combination made `hybrid_graph` improve recall, and 5 / 0.05 is the least damaging
#   by that sweep's rule. `graph_max_neighbors_per_node` was not swept.
#   A change takes effect on the next `xbrain index update`, which rewrites the graph
#   plane whenever the thresholds differ from the ones its manifest sealed.

[embeddings]
# The EXTERNAL embedding backend the knowledge index's vector plane shells out to.
# Like the transcriber and the vision model, the heavy ML lives OUTSIDE xbrain core:
# the CLI carries no model dependency and only invokes this command as a subprocess.
# xbrain invokes:
#   <command> [--model M]
# and hands it the texts as JSON on stdin (argv cannot carry thousands of chunks),
# reading one vector per text back as JSON on stdout. May be a multi-token wrapper
# (split with shlex, run without a shell).
#
# THE WHOLE SECTION IS OPTIONAL, and unset is a supported state rather than a
# half-configured one: with no `command`, `xbrain search` keeps serving lexical
# results and says so in its response. There is NO bundled default, on purpose —
# shipping one would be choosing the embedding model without evaluating it, and the
# model is chosen by the golden set.
#
# With it set, `xbrain index build --embeddings` writes the vector plane (add `--force`
# over an existing index) and `xbrain search --strategy hybrid|vector` uses it. When a
# piece is missing, no answer pretends the vector channel ran (Plan 03 §5):
#   no `command`                  → `hybrid` answers lexical, degraded `embeddings_not_configured`
#   binary missing / failing      → `hybrid` answers lexical, degraded `embedder_unavailable`
#   `--strategy vector` without a plane, a command or a working backend → an ERROR, never
#                                   a lexical answer: you asked for vectors by name
#   a query vector of another dimension than the manifest's → an ERROR (models never mix)
#   the `[embeddings]` extra not installed → an ERROR naming
#                                   `uv pip install 'xbrain[embeddings]'`
#
# The bundled `scripts/xbrain-embed` is the reference backend (sentence-transformers,
# local, nothing leaves the machine). Install its dependency separately — it is
# deliberately not in pyproject.toml:
#   uv tool install sentence-transformers
# command = "/absolute/path/to/scripts/xbrain-embed"
#
# model = "intfloat/multilingual-e5-base"
#   Omit → the backend's own default. Changing it INVALIDATES the vector plane (the
#   lexical plane survives): vectors from two models are never mixed in one matrix.
#
# batch_size = 64
#   How many texts travel per subprocess call.
#
# timeout_seconds = 600
#   Wall-clock cap per batch, so a wedged model cannot hang an index build forever.
#
# query_prefix = "query: "
# passage_prefix = "passage: "
#   A property of the MODEL, not of xbrain. The E5 and BGE families degrade notably
#   without them and expect DIFFERENT strings on the two sides; most other models
#   want neither, which is why both default to empty. They live here so changing
#   model never means editing Python — and they go into the index manifest, because
#   changing one invalidates the stored vectors exactly as changing the model does.
