# Put limit_req_zone directives in nginx's http {} block.
limit_req_zone $binary_remote_addr zone=xbrain_chat:10m rate=12r/m;
limit_req_zone $binary_remote_addr zone=xbrain_search:10m rate=60r/m;
limit_req_zone $binary_remote_addr zone=xbrain_actions:10m rate=20r/m;

server {
    listen 80;
    server_name brain.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name brain.example.com;

    ssl_certificate /etc/letsencrypt/live/brain.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/brain.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    auth_basic "XBrain";
    auth_basic_user_file /etc/nginx/.htpasswd-xbrain;
    client_max_body_size 128k;
    server_tokens off;
    limit_req_status 429;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

    location = /api/chat {
        limit_req zone=xbrain_chat burst=4 nodelay;
        proxy_pass http://127.0.0.1:8765;
        include /etc/nginx/proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
    }

    location = /api/search {
        limit_req zone=xbrain_search burst=15 nodelay;
        proxy_pass http://127.0.0.1:8765;
        include /etc/nginx/proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/api/(refresh-all|retry-failed|reprocess-note|topic-action|delete-bookmark)$ {
        limit_req zone=xbrain_actions burst=5 nodelay;
        proxy_pass http://127.0.0.1:8765;
        include /etc/nginx/proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8765;
        include /etc/nginx/proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
